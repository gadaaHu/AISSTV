# ============================================================
# Attendance System — Environment variables
# Copy to .env and fill in real values:
#   cp .env.example .env
# ============================================================

# ---- app ----
ENV=dev
DEBUG=false

# ---- postgres ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=attendance

# ---- database URL (used by backend) ----
DATABASE_URL=postgresql+asyncpg://app:change-me-strong-password@postgres:5432/attendance

# ---- mqtt ----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=attendance/+/+/+/events
MQTT_CLIENT_ID=backend-consumer

# ---- auth ----
# Generate: openssl rand -hex 64
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# ---- cors ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- evidence ----
EVIDENCE_DIR=/var/lib/attendance/evidence
